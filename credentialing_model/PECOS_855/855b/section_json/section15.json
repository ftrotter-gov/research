                "when": "hasDelegatedOfficial2",
                "eq": true
              }
            },
            {
              "type": "checkbox",
              "label": "This Delegated Official is a W-2 Employee",
              "key": "delegatedOfficial2IsW2",
              "conditional": {
                "show": true,

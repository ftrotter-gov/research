                "eq": true
              }
            },
            {
              "type": "datetime",
              "label": "Date Signed by Delegated Official",
              "key": "delegatedOfficial2DateSigned",
              "format": "MM/dd/yyyy",
              "enableDate": true,
              "enableTime": false,
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial2",
                "eq": true
              }

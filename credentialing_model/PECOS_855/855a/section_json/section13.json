{
  "title": "Section 13: Contact Person",
  "key": "section13ContactPerson",
  "components": [
    {
      "type": "htmlelement",
      "tag": "div",
      "className": "alert alert-info",
      "content": "<h3>Section 13: Contact Person</h3><p>If questions arise during the processing of this application, your designated MAC will contact the individual reported below.</p><p><strong>NOTE:</strong> The contact person listed in this section will only be authorized to discuss issues concerning this or any other enrollment application. Your designated MAC will not discuss any other Medicare issues about you with the above contact person.</p>",
      "key": "section13Header"
    },
    {
      "type": "checkbox",
      "label": "Change - Checking this will add or update contact person information",
      "key": "contactPersonChange"
    },
    {
      "type": "datetime",
      "label": "Effective date of change",
      "key": "contactPersonEffectiveDate",
      "format": "MM/dd/yyyy",
      "enableDate": true,
      "enableTime": false,
      "conditional": {
        "show": true,
        "when": "contactPersonChange",
        "eq": true
      }
    },
    {
      "type": "textfield",
      "label": "First name",
      "key": "contactFirstName",
      "placeholder": "Enter first name"
    },
    {
      "type": "textfield",
      "label": "Middle initial",
      "key": "contactMiddleInitial",
      "inputMask": "A"
    },
    {
      "type": "textfield",
      "label": "Last name",
      "key": "contactLastName",
      "placeholder": "Enter last name"
    },
    {
      "type": "textfield",
      "label": "Suffix (e.g., Jr., Sr., M.D., etc.)",
      "key": "contactSuffix",
      "placeholder": "Enter suffix"
    },
    {
      "type": "textfield",
      "label": "Contact person address line 1 (street name and number)",
      "key": "contactAddress1",
      "placeholder": "Street address"
    },
    {
      "type": "textfield",
      "label": "Contact person address line 2 (suite, room, apt. #, etc.)",
      "key": "contactAddress2",
      "placeholder": "Suite, room, etc."
    },
    {
      "type": "textfield",
      "label": "City/town",
      "key": "contactCity"
    },
    {
      "type": "textfield",
      "label": "State",
      "key": "contactState",
      "inputMask": "AA"
    },
    {
      "type": "textfield",
      "label": "ZIP Code + 4",
      "key": "contactZip",
      "placeholder": "XXXXX-XXXX",
      "inputMask": "99999-9999"
    },
    {
      "type": "phoneNumber",
      "label": "Telephone number",
      "key": "contactPhone"
    },
    {
      "type": "phoneNumber",
      "label": "Fax number (if applicable)",
      "key": "contactFax"
    },
    {
      "type": "email",
      "label": "E-mail address (if applicable)",
      "key": "contactEmail"
    }
  ]
}

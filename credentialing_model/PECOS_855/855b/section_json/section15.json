              "key": "delegatedOfficial1LastName",
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial1",
                "eq": true
              }
            },
            {
              "type": "phoneNumber",
              "label": "Telephone Number",
              "key": "delegatedOfficial1Phone",
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial1",
                "eq": true
              }
            },
            {
              "type": "checkbox",
              "label": "This Delegated Official is a W-2 Employee",
              "key": "delegatedOfficial1IsW2",
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial1",
                "eq": true
              }
            },
            {
              "type": "datetime",
              "label": "Date Signed by Delegated Official",
              "key": "delegatedOfficial1DateSigned",
              "format": "MM/dd/yyyy",
              "enableDate": true,
              "enableTime": false,
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial1",
                "eq": true
              }
            },
            {
              "type": "datetime",
              "label": "Date Signed by Authorized Official Assigning this Delegation",
              "key": "delegatedOfficial1AuthDateSigned",
              "format": "MM/dd/yyyy",
              "enableDate": true,
              "enableTime": false,
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial1",
                "eq": true
              }
            }
          ]
        },
        {
          "type": "panel",
          "title": "2nd Delegated Official (if applicable)",
          "key": "delegatedOfficial2Panel",
          "collapsible": true,
          "collapsed": true,
          "components": [
            {
              "type": "checkbox",
              "label": "Add a 2nd Delegated Official (Shows new form) ◿",
              "key": "hasDelegatedOfficial2"
            },
            {

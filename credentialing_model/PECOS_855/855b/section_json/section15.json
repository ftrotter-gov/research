                "when": "hasDelegatedOfficial2",
                "eq": true
              }
            },
            {
              "type": "textfield",
              "label": "Middle Initial",
              "key": "delegatedOfficial2MiddleInitial",
              "inputMask": "A",
              "conditional": {
                "show": true,
                "when": "hasDelegatedOfficial2",
                "eq": true
              }
            },
            {
              "type": "textfield",
              "label": "Last Name",
              "key": "delegatedOfficial2LastName",
              "conditional": {
